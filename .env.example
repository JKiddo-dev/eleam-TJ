# Configuración de variables de entorno para Desarrollo Local y Netlify
# En Netlify: Site configuration > Environment variables > Add a variable

# 1. API Key de Resend (Obligatorio)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Correo electrónico que recibe los formularios de Contacto y Postulaciones
CONTACT_EMAIL_TO=contacto@residenciateresitadejesus.cl

# 3. Correo remitente verificado en Resend (opcional, por defecto usa onboarding@resend.dev en pruebas)
CONTACT_EMAIL_FROM="Residencia Teresita de Jesús <onboarding@resend.dev>"
