---
const panels = [
  {
    number: 'I',
    title: 'Cuidado profesional',
    subtitle: 'Atención integral y personalizada con más de 33 años de trayectoria',
  },
  {
    number: 'II',
    title: 'Enfermería permanente',
    subtitle: 'Supervisión clínica continua y asistencia TENS las 24 horas del día',
  },
  {
    number: 'III',
    title: 'Vida y tranquilidad',
    subtitle: 'Jardines soleados, talleres activos y calidez de hogar en Vitacura',
  },
];
---

<section aria-label="Presentación institucional">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
      {
        panels.map((panel) => (
          <article class="group relative h-[380px] sm:h-[460px] lg:h-[540px] rounded-2xl overflow-hidden shadow-md border border-neutral-800 bg-neutral-900 flex flex-col justify-between p-6 sm:p-8">
            <div class="flex items-center justify-between text-neutral-400">
              <span class="font-serif italic text-sm tracking-widest text-neutral-300">
                {panel.number}
              </span>
              <span class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-wider text-neutral-400 font-semibold px-2.5 py-1 rounded bg-neutral-800/80 border border-neutral-700/60">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                </svg>
                <span>Fotografía en preparación</span>
              </span>
            </div>

            <div class="my-auto flex flex-col items-center justify-center text-center py-8 px-4 border border-dashed border-neutral-800 rounded-xl bg-neutral-950/40">
              <div class="w-12 h-12 rounded-full bg-neutral-800/60 flex items-center justify-center text-neutral-500 mb-3">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
              </div>
              <p class="text-xs uppercase tracking-wider text-neutral-400 font-bold">
                Registro Visual de la Sede
              </p>
              <p class="text-[11px] text-neutral-500 mt-1 max-w-[210px] leading-relaxed">
                Fotografías oficiales de nuestras instalaciones en Vitacura próximamente disponibles
              </p>
            </div>

            <div class="text-white">
              <div class="w-8 h-px bg-neutral-600 mb-3" />
              <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-white drop-shadow-sm">
                {panel.title}
              </h2>
              <p class="mt-2 text-sm text-neutral-300 leading-relaxed max-w-xs font-normal">
                {panel.subtitle}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div
    class="text-white py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 border-t border-neutral-900"
    style="background-color: #0e1914 !important; color: #ffffff !important;"
  >
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <p class="text-xs sm:text-sm uppercase tracking-[0.24em] text-neutral-300 font-bold" style="color: #d1d5db !important;">
        Más de 33 años al cuidado del adulto mayor · Sede exclusiva en Vitacura
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight" style="color: #ffffff !important;">
        Residencia Teresita de Jesús
      </h1>

      <div class="w-16 h-px bg-neutral-400 mx-auto" />

      <p class="text-base sm:text-lg text-neutral-200 leading-relaxed max-w-2xl mx-auto font-normal" style="color: #e5e7eb !important;">
        Iniciamos nuestra labor en 1988 a partir de la promesa de cuidar a nuestros seres queridos por siempre. En nuestra sede única de calle Islas Marianas 1791 en Vitacura, entregamos un ambiente sereno, supervisión médica rigurosa y el afecto constante de un segundo hogar.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contacto"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-neutral-100 text-neutral-950 font-bold text-base rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 focus:outline-none"
          style="background-color: #ffffff !important; color: #0a0a0a !important;"
        >
          Agendar Visita Presencial
        </a>
        <a
          href="/quienes-somos"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 border-2 border-white hover:bg-white hover:text-neutral-950 text-white font-bold text-base rounded-xl transition-all duration-200 focus:outline-none shadow-sm"
          style="color: #ffffff !important; border-color: #ffffff !important; background-color: rgba(255, 255, 255, 0.1) !important;"
        >
          Conocer Nuestra Historia
        </a>
      </div>
    </div>
  </div>
</section>
