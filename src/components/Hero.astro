---
const WHATSAPP_URL =
  'https://wa.me/56979655573?text=Hola%2C%20quisiera%20agendar%20una%20visita%20en%20Residencia%20Teresita%20de%20Jes%C3%BAs%20en%20Vitacura.';

const panels = [
  {
    number: 'I',
    title: 'Atención personal',
    subtitle: 'Cuidado cercano las 24 horas, 5 comidas diarias y lavado de ropa incluido',
    image: '/images/residencia/05-ajedrez-compania.jpg',
    alt: 'Atención personal y compañía cercana en Residencia Teresita de Jesús',
    position: 'object-top',
  },
  {
    number: 'II',
    title: 'Casa de 1 piso',
    subtitle: 'Piezas individuales y compartidas en un solo nivel seguro y luminoso',
    image: '/images/residencia/02-habitacion-luminosa.jpg',
    alt: 'Habitación luminosa en casa de un piso en Vitacura',
    position: 'object-center',
  },
  {
    number: 'III',
    title: 'Seguimiento médico y hogar',
    subtitle: '1 visita médica personal semanal con 10 años de experiencia en el hogar',
    image: '/images/residencia/01-jardin-convivencia.jpg',
    alt: 'Residentes disfrutando del jardín en nuestra sede de Vitacura',
    position: 'object-[50%_20%]',
  },
];

const highlights = [
  'Casa de 1 piso',
  'Piezas individuales y compartidas',
  'Atención personal 24/7',
  '5 comidas diarias',
  'Lavado de ropa',
  'Visita médica semanal (10 años en el hogar)',
];
---

<section aria-label="Presentación institucional">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
      {
        panels.map((panel) => (
          <article class="group relative h-[390px] sm:h-[460px] lg:h-[520px] rounded-2xl overflow-hidden shadow-md border border-neutral-800 bg-neutral-900 flex flex-col justify-between p-6 sm:p-8">
            <img
              src={panel.image}
              alt={panel.alt}
              width="960"
              height="1280"
              fetchpriority="high"
              decoding="async"
              class={`absolute inset-0 w-full h-full object-cover ${panel.position} transition-transform duration-700 group-hover:scale-105`}
            />

            <div
              class="absolute inset-0 pointer-events-none"
              style="background: linear-gradient(to top, rgba(10, 18, 14, 0.92) 0%, rgba(10, 18, 14, 0.48) 42%, rgba(10, 18, 14, 0.18) 100%);"
            />

            <div class="relative z-10 flex items-center justify-between">
              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-full font-serif italic text-sm tracking-widest border border-white/30 backdrop-blur-xs"
                style="background-color: rgba(14, 25, 20, 0.65); color: #ffffff !important;"
              >
                {panel.number}
              </span>
            </div>

            <div class="relative z-10 text-white">
              <div class="w-8 h-px bg-white/60 mb-3" />
              <h2
                class="font-serif text-2xl sm:text-3xl font-bold tracking-tight leading-snug drop-shadow-sm"
                style="color: #ffffff !important;"
              >
                {panel.title}
              </h2>
              <p
                class="mt-2 text-sm leading-relaxed max-w-xs font-normal"
                style="color: #f3f4f6 !important;"
              >
                {panel.subtitle}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div
    class="text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-t border-neutral-900"
    style="background-color: #0e1914 !important; color: #ffffff !important;"
  >
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <p class="text-xs sm:text-sm uppercase tracking-[0.24em] text-neutral-300 font-bold" style="color: #d1d5db !important;">
        Islas Marianas 1791 · Sede Exclusiva en Vitacura
      </p>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight" style="color: #ffffff !important;">
        Residencia Teresita de Jesús
      </h1>

      <div class="w-16 h-px bg-neutral-400 mx-auto" />

      <blockquote
        class="font-serif italic text-xl sm:text-2xl leading-relaxed max-w-2xl mx-auto"
        style="color: #f3f4f6 !important;"
      >
        “Un 12 de marzo se creó mi historia pensada en mis padres. Han pasado tantos años y aún me emociono.”
      </blockquote>

      <ul class="pt-1 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs sm:text-sm font-medium max-w-3xl mx-auto" style="color: #e5e7eb !important;">
        {
          highlights.map((item) => (
            <li class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/80 shrink-0" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-neutral-100 text-neutral-950 font-bold text-base rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 focus:outline-none"
          style="background-color: #ffffff !important; color: #0a0a0a !important;"
        >
          Agendar Visita por WhatsApp
        </a>
        <a
          href="/servicios-e-instalaciones"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 border-2 border-white hover:bg-white hover:text-neutral-950 text-white font-bold text-base rounded-xl transition-all duration-200 focus:outline-none shadow-sm"
          style="color: #ffffff !important; border-color: #ffffff !important; background-color: rgba(255, 255, 255, 0.1) !important;"
        >
          Servicios e Instalaciones
        </a>
      </div>
    </div>
  </div>
</section>
