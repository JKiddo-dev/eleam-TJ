---
const WHATSAPP_URL =
  'https://wa.me/56979655573?text=Hola%2C%20quisiera%20agendar%20una%20visita%20en%20Residencia%20Teresita%20de%20Jes%C3%BAs%20en%20Vitacura.';
---

<section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-neutral-100 border-t border-neutral-300">
  <div class="max-w-4xl mx-auto text-center space-y-6">
    <p class="text-xs uppercase tracking-[0.24em] text-neutral-600 font-bold">
      Admisión y Visitas Presenciales · Sede Única Vitacura
    </p>

    <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-950 tracking-tight leading-tight">
      Le invitamos a conocer personalmente nuestra residencia
    </h2>

    <div class="w-16 h-px bg-neutral-400 mx-auto" />

    <p class="text-base sm:text-lg text-neutral-800 leading-relaxed max-w-2xl mx-auto font-normal">
      Disponemos de piezas individuales y compartidas en nuestra casa de 1 piso en Islas Marianas 1791, Vitacura. Las visitas no tienen horario restringido; solo es necesario agendar previamente por WhatsApp o teléfono.
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-neutral-950 hover:bg-neutral-800 text-white font-bold text-base rounded-xl shadow-md hover:shadow-lg transition-all duration-200 border border-neutral-950"
        style="background-color: #0e1914 !important; color: #ffffff !important;"
      >
        Agendar por WhatsApp
      </a>
      <a
        href="tel:+56979655573"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-white hover:bg-neutral-100 text-neutral-950 border-2 border-neutral-950 font-bold text-base rounded-xl shadow-sm hover:shadow-md transition-all duration-200"
        style="background-color: #ffffff !important; color: #0a0a0a !important; border-color: #0a0a0a !important;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" style="color: #0e1914;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        <span style="color: #0a0a0a !important;">Celular +56 9 7965 5573</span>
      </a>
    </div>

    <p class="text-sm text-neutral-700 font-semibold pt-1">
      Teléfono fijo: <a href="tel:+56222190398" class="text-neutral-950 font-bold underline underline-offset-4 hover:text-emerald-900">+56 2 2219 0398</a>
    </p>
  </div>
</section>
