---
const spaces = [
  {
    category: 'Exteriores',
    title: 'Jardines y Terrazas Soleadas',
    description: 'Áreas verdes tranquilas y terrazas techadas para el paseo y descanso al aire libre.',
    image: '/images/residencia/03-terraza-jardin.jpg',
    alt: 'Terraza techada y jardín soleado en Residencia Teresita de Jesús en Vitacura',
    lightboxIndex: 0,
  },
  {
    category: 'Estadía',
    title: 'Piezas Individuales y Compartidas',
    description: 'Dormitorios luminosos, climatizados y equipados para asegurar privacidad y confort.',
    image: '/images/residencia/02-habitacion-luminosa.jpg',
    alt: 'Pieza luminosa con piso de madera y ventana al jardín en Vitacura',
    lightboxIndex: 1,
  },
  {
    category: 'Espacios Comunes',
    title: 'Salones Luminosos y Climatizados',
    description: 'Ambientes amplios y accesibles pensados para la convivencia diaria y visitas familiares.',
    image: '/images/residencia/10-salon-principal.jpg',
    alt: 'Salón principal amplio e iluminado con residentes compartiendo actividades',
    lightboxIndex: 2,
  },
  {
    category: 'Vida Activa',
    title: 'Talleres y Estimulación Diaria',
    description: 'Lectura, ajedrez y actividades motrices que promueven el bienestar cognitivo.',
    image: '/images/residencia/08-talleres-cognitivos.jpg',
    alt: 'Residentes participando en taller de pintura y lectura junto al ventanal',
    lightboxIndex: 3,
  },
];

const carouselPhotos = [
  {
    image: '/images/residencia/01-jardin-convivencia.jpg',
    caption: 'Tardes soleadas en nuestro jardín de Vitacura',
    lightboxIndex: 4,
  },
  {
    image: '/images/residencia/09-apoyo-personalizado.jpg',
    caption: 'Acompañamiento cercano y dedicado en cada actividad',
    lightboxIndex: 5,
  },
  {
    image: '/images/residencia/04-cuidado-acompanamiento.jpg',
    caption: 'Calidez humana y supervisión permanente',
    lightboxIndex: 6,
  },
  {
    image: '/images/residencia/06-comunidad-vitacura.jpg',
    caption: 'Encuentro y lectura con luz natural de mañana',
    lightboxIndex: 7,
  },
  {
    image: '/images/residencia/05-ajedrez-compania.jpg',
    caption: 'Juegos de salón que fortalecen la memoria y el vínculo',
    lightboxIndex: 8,
  },
  {
    image: '/images/residencia/17-rincon-lectura.jpg',
    caption: 'Espacios tranquilos para el hábito de la lectura',
    lightboxIndex: 9,
  },
  {
    image: '/images/residencia/13-estimulacion-mental.jpg',
    caption: 'Partidas de ajedrez y concentración activa',
    lightboxIndex: 10,
  },
  {
    image: '/images/residencia/16-taller-compartido.jpg',
    caption: 'Talleres artísticos grupales en mesa común',
    lightboxIndex: 11,
  },
  {
    image: '/images/residencia/11-vida-activa.jpg',
    caption: 'Convivencia diaria en salones climatizados',
    lightboxIndex: 12,
  },
  {
    image: '/images/residencia/14-motricidad-fina.jpg',
    caption: 'Ejercicios de motricidad fina y expresión creativa',
    lightboxIndex: 13,
  },
  {
    image: '/images/residencia/15-taller-artistico.jpg',
    caption: 'Arte y lectura botánica durante la jornada',
    lightboxIndex: 14,
  },
  {
    image: '/images/residencia/07-lectura-ajedrez.jpg',
    caption: 'Mañanas recreativas con vista a los jardines',
    lightboxIndex: 15,
  },
  {
    image: '/images/residencia/18-tarde-recreativa.jpg',
    caption: 'Recreación y camaradería entre residentes',
    lightboxIndex: 16,
  },
  {
    image: '/images/residencia/12-partida-ajedrez.jpg',
    caption: 'Entusiasmo y agilidad mental en cada jornada',
    lightboxIndex: 17,
  },
];

const allLightboxItems = [
  ...spaces.map((s) => ({ src: s.image, caption: `${s.title} — ${s.description}` })),
  ...carouselPhotos.map((p) => ({ src: p.image, caption: p.caption })),
];
---

<section id="instalaciones" class="py-20 sm:py-26 px-4 sm:px-6 lg:px-8 bg-neutral-100 border-y border-neutral-200">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-14">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-bold mb-2">
          Nuestra Casa en Islas Marianas 1791 · Vitacura
        </p>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-950 tracking-tight leading-tight">
          Instalaciones pensadas para la calma y la seguridad
        </h2>
      </div>
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] font-bold text-neutral-950 hover:text-emerald-800 border-b-2 border-neutral-950 pb-1 self-start md:self-auto transition-colors"
      >
        <span>Solicitar visita guiada</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7">
      {
        spaces.map((space) => (
          <figure class="group flex flex-col">
            <button
              type="button"
              data-lightbox-index={space.lightboxIndex}
              class="relative overflow-hidden bg-neutral-200 rounded-2xl aspect-[3/4] w-full text-left shadow-sm border border-neutral-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-neutral-900"
              aria-label={`Ampliar fotografía: ${space.title}`}
            >
              <img
                src={space.image}
                alt={space.alt}
                width="960"
                height="1280"
                loading="lazy"
                decoding="async"
                draggable="false"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </button>
            <figcaption class="pt-4 border-b border-neutral-300 pb-5 flex-1 flex flex-col justify-between">
              <div>
                <span class="block text-[11px] uppercase tracking-[0.2em] text-neutral-500 font-bold mb-1">
                  {space.category}
                </span>
                <h3 class="font-serif text-xl sm:text-2xl font-bold text-neutral-950 leading-snug">
                  {space.title}
                </h3>
                <p class="mt-1.5 text-sm text-neutral-700 leading-relaxed font-normal">
                  {space.description}
                </p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-16 pt-12 border-t border-neutral-300">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7">
        <div>
          <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-bold mb-1.5">
            Galería Completa · Registro Real
          </p>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-neutral-950 tracking-tight">
            Vida cotidiana y acompañamiento en nuestra residencia
          </h3>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <button
            type="button"
            id="gallery-carousel-prev"
            class="w-11 h-11 rounded-full border-2 border-neutral-950 bg-white text-neutral-950 hover:bg-neutral-950 hover:text-white flex items-center justify-center transition-colors shadow-xs cursor-pointer focus:outline-none"
            style="background-color: #ffffff !important; border-color: #0e1914 !important; color: #0a0a0a !important;"
            aria-label="Ver fotografías anteriores"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>

          <button
            type="button"
            id="gallery-carousel-next"
            class="w-11 h-11 rounded-full border-2 border-neutral-950 bg-neutral-950 text-white hover:bg-neutral-800 flex items-center justify-center transition-colors shadow-xs cursor-pointer focus:outline-none"
            style="background-color: #0e1914 !important; border-color: #0e1914 !important; color: #ffffff !important;"
            aria-label="Ver siguientes fotografías"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      </div>

      <div
        id="gallery-carousel-track"
        class="flex gap-4 sm:gap-5 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scroll-smooth cursor-grab select-none"
        style="scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch;"
        role="region"
        aria-label="Galería fotográfica deslizable de Residencia Teresita de Jesús"
      >
        {
          carouselPhotos.map((photo) => (
            <figure class="w-[68vw] sm:w-[230px] lg:w-[250px] shrink-0 snap-start group">
              <button
                type="button"
                data-lightbox-index={photo.lightboxIndex}
                class="relative block w-full aspect-[3/4] rounded-xl overflow-hidden bg-neutral-200 border border-neutral-300 shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-neutral-900"
                aria-label={`Ampliar imagen: ${photo.caption}`}
              >
                <img
                  src={photo.image}
                  alt={photo.caption}
                  width="720"
                  height="960"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div
                  class="absolute inset-x-0 bottom-0 p-3.5 text-left"
                  style="background: linear-gradient(to top, rgba(10, 18, 14, 0.88) 0%, rgba(10, 18, 14, 0.38) 65%, transparent 100%);"
                >
                  <p class="text-xs leading-snug font-medium" style="color: #ffffff !important;">
                    {photo.caption}
                  </p>
                </div>
              </button>
            </figure>
          ))
        }
      </div>

      <div class="mt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-neutral-600 font-semibold">
        <p class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
          <span>Arrastre la galería o haga clic sobre cualquier fotografía para ampliarla</span>
        </p>
        <span class="text-neutral-500 font-medium">18 fotografías reales en Vitacura</span>
      </div>
    </div>
  </div>
</section>

<div
  id="gallery-lightbox"
  class="fixed inset-0 z-[120] hidden items-center justify-center p-4 sm:p-8"
  style="background-color: rgba(10, 15, 12, 0.94);"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de fotografías"
>
  <button
    type="button"
    id="gallery-lightbox-close"
    class="absolute top-4 right-4 sm:top-6 sm:right-6 z-20 w-11 h-11 rounded-full flex items-center justify-center shadow-lg cursor-pointer focus:outline-none"
    style="background-color: #ffffff !important; color: #0a0a0a !important;"
    aria-label="Cerrar visor"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <button
    type="button"
    id="gallery-lightbox-prev"
    class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full flex items-center justify-center shadow-lg cursor-pointer focus:outline-none"
    style="background-color: #ffffff !important; color: #0a0a0a !important;"
    aria-label="Fotografía anterior"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
  </button>

  <button
    type="button"
    id="gallery-lightbox-next"
    class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full flex items-center justify-center shadow-lg cursor-pointer focus:outline-none"
    style="background-color: #ffffff !important; color: #0a0a0a !important;"
    aria-label="Fotografía siguiente"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
    </svg>
  </button>

  <div class="relative z-10 max-w-3xl w-full flex flex-col items-center">
    <img
      id="gallery-lightbox-img"
      src=""
      alt=""
      class="max-h-[78vh] w-auto rounded-xl shadow-2xl object-contain"
    />
    <div class="mt-4 text-center px-10">
      <p id="gallery-lightbox-caption" class="text-sm sm:text-base font-medium" style="color: #ffffff !important;"></p>
      <p id="gallery-lightbox-counter" class="text-xs mt-1" style="color: #9ca3af !important;"></p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ allLightboxItems }}>
  (function () {
    const track = document.getElementById('gallery-carousel-track');
    const prevBtn = document.getElementById('gallery-carousel-prev');
    const nextBtn = document.getElementById('gallery-carousel-next');

    let isDown = false;
    let hasDragged = false;
    let startX = 0;
    let scrollLeft = 0;

    if (track) {
      function getScrollStep() {
        const card = track.querySelector('figure');
        return card ? card.offsetWidth + 20 : 270;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          track.scrollBy({ left: -getScrollStep() * 2, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          track.scrollBy({ left: getScrollStep() * 2, behavior: 'smooth' });
        });
      }

      track.addEventListener('mousedown', function (e) {
        isDown = true;
        hasDragged = false;
        track.classList.add('cursor-grabbing');
        track.classList.remove('cursor-grab', 'snap-x', 'scroll-smooth');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', function () {
        if (isDown) {
          isDown = false;
          track.classList.remove('cursor-grabbing');
          track.classList.add('cursor-grab', 'snap-x', 'scroll-smooth');
        }
      });

      track.addEventListener('mouseup', function () {
        if (isDown) {
          isDown = false;
          track.classList.remove('cursor-grabbing');
          track.classList.add('cursor-grab', 'snap-x', 'scroll-smooth');
        }
      });

      track.addEventListener('mousemove', function (e) {
        if (!isDown) return;
        const x = e.pageX - track.offsetLeft;
        const delta = x - startX;
        if (Math.abs(delta) > 6) {
          hasDragged = true;
        }
        e.preventDefault();
        track.scrollLeft = scrollLeft - delta * 1.6;
      });
    }

    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('gallery-lightbox-img');
    const lightboxCaption = document.getElementById('gallery-lightbox-caption');
    const lightboxCounter = document.getElementById('gallery-lightbox-counter');
    const lbClose = document.getElementById('gallery-lightbox-close');
    const lbPrev = document.getElementById('gallery-lightbox-prev');
    const lbNext = document.getElementById('gallery-lightbox-next');

    let currentIndex = 0;

    function renderLightbox(index) {
      if (!allLightboxItems || !allLightboxItems.length) return;
      currentIndex = (index + allLightboxItems.length) % allLightboxItems.length;
      const item = allLightboxItems[currentIndex];
      if (lightboxImg) {
        lightboxImg.src = item.src;
        lightboxImg.alt = item.caption;
      }
      if (lightboxCaption) {
        lightboxCaption.textContent = item.caption;
      }
      if (lightboxCounter) {
        lightboxCounter.textContent = (currentIndex + 1) + ' / ' + allLightboxItems.length;
      }
    }

    function openLightbox(index) {
      if (!lightbox) return;
      renderLightbox(index);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    const triggers = document.querySelectorAll('[data-lightbox-index]');
    triggers.forEach(function (trigger) {
      trigger.addEventListener('click', function (e) {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
          hasDragged = false;
          return;
        }
        const idx = Number(trigger.getAttribute('data-lightbox-index') || '0');
        openLightbox(idx);
      });
    });

    if (lbClose) lbClose.addEventListener('click', closeLightbox);
    if (lbPrev) lbPrev.addEventListener('click', function () { renderLightbox(currentIndex - 1); });
    if (lbNext) lbNext.addEventListener('click', function () { renderLightbox(currentIndex + 1); });

    if (lightbox) {
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) closeLightbox();
      });
    }

    window.addEventListener('keydown', function (e) {
      if (!lightbox || lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') renderLightbox(currentIndex - 1);
      if (e.key === 'ArrowRight') renderLightbox(currentIndex + 1);
    });
  })();
</script>
