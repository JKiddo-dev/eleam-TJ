---
const spaces = [
  {
    category: 'Exteriores',
    title: 'Jardines y Terrazas Soleadas',
    description: 'Áreas verdes tranquilas con senderos planos que invitan al paseo diario y a la lectura al aire libre.',
    span: 'lg:col-span-7',
  },
  {
    category: 'Descanso',
    title: 'Habitaciones Luminosas y Adaptadas',
    description: 'Dormitorios ventilados, calefaccionados y equipados para asegurar comodidad y descanso reparador.',
    span: 'lg:col-span-5',
  },
  {
    category: 'Vida en Común',
    title: 'Salones de Estar y Encuentro Familiar',
    description: 'Ambientes cálidos y silenciosos diseñados para recibir a los familiares con total privacidad.',
    span: 'lg:col-span-5',
  },
  {
    category: 'Gastronomía Casera',
    title: 'Comedor Principal',
    description: 'Espacio amplio y luminoso donde se sirven diariamente preparaciones caseras supervisadas por nutricionista.',
    span: 'lg:col-span-7',
  },
];
---

<section id="instalaciones" class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-neutral-100 border-y border-neutral-200">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 sm:mb-18">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-bold mb-2">
          Nuestra Casa en Vitacura
        </p>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-950 tracking-tight leading-tight">
          Instalaciones pensadas para la calma y la seguridad
        </h2>
      </div>
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] font-bold text-neutral-950 hover:text-emerald-800 border-b-2 border-neutral-950 pb-1 self-start md:self-auto transition-colors"
      >
        <span>Solicitar visita guiada</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10">
      {
        spaces.map((space) => (
          <figure class={`group flex flex-col ${space.span}`}>
            <div class="overflow-hidden bg-neutral-200/70 border-2 border-dashed border-neutral-300 rounded-2xl aspect-[16/10] flex flex-col items-center justify-center p-6 text-center">
              <div class="w-12 h-12 rounded-full bg-neutral-300/60 flex items-center justify-center text-neutral-600 mb-3">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                </svg>
              </div>
              <p class="text-xs uppercase tracking-wider text-neutral-700 font-bold">
                {space.title}
              </p>
              <span class="text-[11px] text-neutral-500 mt-1">
                Fotografía oficial en preparación
              </span>
            </div>
            <figcaption class="pt-5 border-b border-neutral-300 pb-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="block text-[11px] uppercase tracking-[0.2em] text-neutral-500 font-bold mb-1.5">
                  {space.category}
                </span>
                <h3 class="font-serif text-2xl font-bold text-neutral-950">
                  {space.title}
                </h3>
                <p class="mt-2 text-sm text-neutral-700 leading-relaxed font-normal">
                  {space.description}
                </p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
