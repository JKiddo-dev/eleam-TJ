---
const officialServices = [
  {
    number: '01',
    title: 'Casa de 1 Piso y Piezas Adaptadas',
    description: 'Casa de un solo piso sin escaleras, con piezas individuales y compartidas luminosas y seguras.',
  },
  {
    number: '02',
    title: '1 Visita Médica Personal Semanal',
    description: 'Control médico personal todas las semanas con profesional que cuenta con 10 años de experiencia en el hogar.',
  },
  {
    number: '03',
    title: 'Atención Personal las 24 Horas',
    description: 'Acompañamiento cercano, trato dedicado y monitoreo permanente por TENS y cuidadoras en turnos continuos.',
  },
  {
    number: '04',
    title: '5 Comidas Diarias',
    description: 'Cinco comidas caseras al día, frescas, balanceadas y adaptadas a las necesidades de cada residente.',
  },
  {
    number: '05',
    title: 'Lavado de Ropa y Aseo Diario',
    description: 'Servicio incluido de lavado de ropa personal, ropería e higiene diaria de habitaciones y espacios comunes.',
  },
  {
    number: '06',
    title: 'Convenio de Salud y U. de los Andes',
    description: 'Convenio formal con profesionales y especialistas para un respaldo clínico oportuno y de alto estándar.',
  },
  {
    number: '07',
    title: 'Kinesiólogo y Neurólogo',
    description: 'Atención kinesiológica motora y respiratoria regular, junto con seguimiento neurológico especializado.',
  },
  {
    number: '08',
    title: 'Laboratorio Clínico a Domicilio',
    description: 'Toma de muestras y exámenes directamente en nuestra residencia de Vitacura, evitando traslados innecesarios.',
  },
  {
    number: '09',
    title: 'Talleres Artísticos y Motrices',
    description: 'Lectura, pintura, juegos de mesa y ejercicios diarios enfocados en preservar la agilidad cognitiva y física.',
  },
  {
    number: '10',
    title: 'Cuidado según Dependencia',
    description: 'Atención personal respetuosa preparada para adultos mayores autovalentes o con distintos grados de dependencia.',
  },
];
---

<section id="servicios" class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 bg-neutral-50 border-b border-neutral-200">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 sm:mb-10">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-bold mb-2">
          Prestaciones Incluidas y Respaldo Clínico
        </p>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-neutral-950 tracking-tight leading-tight">
          Atención personal, control médico semanal y calidez de hogar
        </h2>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <button
          type="button"
          id="services-carousel-prev"
          class="w-12 h-12 rounded-full border-2 border-neutral-950 bg-white text-neutral-950 hover:bg-neutral-950 hover:text-white flex items-center justify-center transition-colors shadow-xs cursor-pointer focus:outline-none"
          style="border-color: #0e1914 !important;"
          aria-label="Ver servicios anteriores"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>

        <button
          type="button"
          id="services-carousel-next"
          class="w-12 h-12 rounded-full border-2 border-neutral-950 bg-neutral-950 text-white hover:bg-neutral-800 flex items-center justify-center transition-colors shadow-xs cursor-pointer focus:outline-none"
          style="background-color: #0e1914 !important; border-color: #0e1914 !important; color: #ffffff !important;"
          aria-label="Ver siguientes servicios"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>
    </div>

    <div
      id="services-carousel-track"
      class="flex gap-5 sm:gap-6 overflow-x-auto pb-6 pt-2 snap-x snap-mandatory scroll-smooth cursor-grab select-none"
      style="scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch;"
      role="region"
      aria-label="Carrusel de servicios oficiales arrastrable con el mouse"
    >
      {
        officialServices.map((service) => (
          <article class="w-[84vw] sm:w-[320px] lg:w-[360px] shrink-0 snap-start bg-white border-2 border-neutral-200 rounded-2xl p-7 flex flex-col justify-between shadow-xs hover:border-neutral-900 transition-colors pointer-events-auto">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-serif text-sm font-bold text-neutral-400 tracking-wider">
                  {service.number}
                </span>
                <span class="w-2.5 h-2.5 rounded-full" style="background-color: #0e1914;"></span>
              </div>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-neutral-950 leading-snug mb-3">
                {service.title}
              </h3>
              <p class="text-sm text-neutral-700 leading-relaxed font-normal">
                {service.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between text-xs text-neutral-500 font-semibold">
              <span>Sede Vitacura</span>
              <span class="text-neutral-950 font-bold">24/7</span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-neutral-600 font-semibold">
      <p class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
        </svg>
        <span>Arrastre con el mouse hacia los lados o utilice las flechas para explorar</span>
      </p>
      <span class="text-neutral-500 font-medium">10 servicios esenciales</span>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const track = document.getElementById('services-carousel-track');
    const prevBtn = document.getElementById('services-carousel-prev');
    const nextBtn = document.getElementById('services-carousel-next');

    if (!track) return;

    function getScrollStep() {
      const card = track.querySelector('article');
      return card ? card.offsetWidth + 24 : 340;
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
      });
    }

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    track.addEventListener('mousedown', function (e) {
      isDown = true;
      track.classList.add('cursor-grabbing');
      track.classList.remove('cursor-grab', 'snap-x', 'scroll-smooth');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', function () {
      if (isDown) {
        isDown = false;
        track.classList.remove('cursor-grabbing');
        track.classList.add('cursor-grab', 'snap-x', 'scroll-smooth');
      }
    });

    track.addEventListener('mouseup', function () {
      if (isDown) {
        isDown = false;
        track.classList.remove('cursor-grabbing');
        track.classList.add('cursor-grab', 'snap-x', 'scroll-smooth');
      }
    });

    track.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.6;
      track.scrollLeft = scrollLeft - walk;
    });
  })();
</script>
