---
const pathname = Astro.url.pathname;

const WHATSAPP_URL =
  'https://wa.me/56979655573?text=Hola%2C%20quisiera%20agendar%20una%20visita%20en%20Residencia%20Teresita%20de%20Jes%C3%BAs%20en%20Vitacura.';

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios e Instalaciones', href: '/servicios-e-instalaciones' },
  { label: 'Quiénes Somos', href: '/quienes-somos' },
  { label: 'Testimonios', href: '/testimonios' },
];
---

<header class="sticky top-0 z-40 w-full bg-white border-b border-neutral-200 shadow-xs">
  <div
    class="bg-neutral-950 text-white text-xs tracking-wide border-b border-neutral-900"
    style="background-color: #0e1914 !important; color: #ffffff !important;"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-col sm:flex-row items-center justify-between gap-1.5">
      <p class="font-normal text-center sm:text-left text-neutral-200" style="color: #e5e7eb !important;">
        Islas Marianas 1791, Vitacura <span class="hidden sm:inline mx-2 text-neutral-400">|</span> <span class="block sm:inline text-neutral-200">Casa de 1 piso · Piezas individuales y compartidas</span>
      </p>
      <div class="flex items-center gap-4 font-bold text-white" style="color: #ffffff !important;">
        <a href="tel:+56979655573" class="hover:text-emerald-300 transition-colors" style="color: #ffffff !important;">+56 9 7965 5573</a>
        <span class="text-neutral-400">·</span>
        <a href="tel:+56222190398" class="hover:text-emerald-300 transition-colors" style="color: #ffffff !important;">+56 2 2219 0398</a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-white">
    <nav class="h-20 sm:h-22 flex items-center justify-between gap-4" aria-label="Navegación institucional">
      <a href="/" class="group focus:outline-none">
        <span class="block font-serif text-xl sm:text-2xl lg:text-3xl font-bold text-neutral-950 tracking-tight leading-none" style="color: #0a0a0a !important;">
          Residencia Teresita de Jesús
        </span>
        <span class="block text-[10px] sm:text-[11px] uppercase tracking-[0.2em] text-neutral-600 mt-1.5 font-bold">
          Islas Marianas 1791 · Vitacura · Desde 1988
        </span>
      </a>

      <div class="hidden lg:flex items-center gap-7">
        <ul class="flex items-center gap-6 text-sm font-bold text-neutral-800">
          {
            navItems.map((item) => {
              const isActive =
                item.href === '/'
                  ? pathname === '/'
                  : pathname.startsWith(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    class={`py-1 transition-colors border-b-2 ${
                      isActive
                        ? 'border-neutral-950 font-bold'
                        : 'border-transparent text-neutral-700 hover:border-neutral-400'
                    }`}
                    style={isActive ? 'color: #0e1914 !important; border-color: #0e1914 !important;' : 'color: #374151 !important;'}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-2.5 bg-neutral-950 hover:bg-neutral-800 text-white text-sm font-bold rounded-lg shadow-md hover:shadow-lg transition-all duration-200 border border-neutral-950"
          style="background-color: #0e1914 !important; color: #ffffff !important;"
        >
          Agendar Visita
        </a>
      </div>

      <div class="flex lg:hidden items-center gap-2.5">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-3.5 py-2 bg-neutral-950 hover:bg-neutral-800 text-white text-xs font-bold rounded-lg shadow-sm transition-colors"
          style="background-color: #0e1914 !important; color: #ffffff !important;"
        >
          Agendar Visita
        </a>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex items-center justify-center p-2.5 bg-neutral-950 hover:bg-neutral-800 text-white rounded-lg shadow-sm focus:outline-none cursor-pointer"
          style="background-color: #0e1914 !important; color: #ffffff !important;"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          aria-label="Abrir menú de navegación"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<div
  id="mobile-drawer"
  class="fixed inset-0 z-[100] hidden flex flex-col justify-between overflow-y-auto"
  style="background-color: #ffffff !important;"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación móvil"
>
  <div class="px-6 py-5 border-b border-neutral-200 flex items-center justify-between bg-neutral-50">
    <div>
      <span class="block font-serif text-xl font-bold text-neutral-950">
        Residencia Teresita de Jesús
      </span>
      <span class="block text-[11px] uppercase tracking-wider text-neutral-600 font-bold mt-0.5">
        Sede Vitacura · Desde 1988
      </span>
    </div>
    <button
      type="button"
      id="mobile-drawer-close"
      class="p-2.5 bg-neutral-950 hover:bg-neutral-800 text-white rounded-lg shadow-sm cursor-pointer"
      style="background-color: #0e1914 !important; color: #ffffff !important;"
      aria-label="Cerrar menú"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="px-6 py-8 flex-1 bg-white">
    <p class="text-xs uppercase tracking-wider text-neutral-500 font-bold mb-3">Navegación</p>
    <ul class="flex flex-col divide-y divide-neutral-200 text-lg font-serif">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="block py-4 text-neutral-950 hover:text-emerald-800 font-bold transition-colors mobile-nav-link"
              style="color: #0a0a0a !important;"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 pt-2">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-center py-4 px-6 bg-neutral-950 hover:bg-neutral-800 text-white font-bold text-base rounded-xl shadow-md transition-colors mobile-nav-link"
        style="background-color: #0e1914 !important; color: #ffffff !important;"
      >
        Agendar Visita por WhatsApp
      </a>
    </div>
  </div>

  <div class="px-6 py-6 border-t border-neutral-200 bg-neutral-100 text-xs text-neutral-700 space-y-2">
    <p class="font-bold text-neutral-950">Islas Marianas 1791, Vitacura · Piezas individuales y compartidas</p>
    <div class="flex items-center gap-3 text-neutral-950 font-bold text-sm">
      <a href="tel:+56979655573">+56 9 7965 5573</a>
      <span class="text-neutral-400">·</span>
      <a href="tel:+56222190398">+56 2 2219 0398</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const drawer = document.getElementById('mobile-drawer');

    function openMenu() {
      if (!drawer) return;
      drawer.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      if (!drawer) return;
      drawer.classList.add('hidden');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);

    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
        closeMenu();
      }
    });
  })();
</script>
