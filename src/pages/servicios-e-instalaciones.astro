---
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';

const serviceSchema = [
  {
    '@type': 'Service',
    name: 'Residencia, Hogar de Reposo y Cuidado Integral de Adultos Mayores en Vitacura',
    provider: { '@id': 'https://eleamteresitadejesus.cl/#organization' },
    areaServed: { '@type': 'AdministrativeArea', name: 'Vitacura' },
    serviceType: 'Hogar de reposo y ELEAM para adultos mayores',
    description:
      'Cuidado integral de adultos mayores en casa de 1 piso en Vitacura: piezas individuales y compartidas, enfermería TENS 24 horas, visita médica personal semanal, 5 comidas diarias y lavado de ropa.',
  },
];
---

<Layout
  title="Servicios de Cuidado de Adultos Mayores e Instalaciones | Hogar Teresita de Jesús Vitacura"
  description="Servicios de nuestra casa de reposo y ELEAM en Islas Marianas 1791, Vitacura: casa de 1 piso, piezas individuales y compartidas, atención personal 24/7, visita médica semanal y 5 comidas diarias."
  extraSchema={serviceSchema}
>
  <main>
    <section
      class="text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b border-neutral-900"
      style="background-color: #0e1914 !important; color: #ffffff !important;"
    >
      <div class="max-w-4xl mx-auto text-center space-y-5">
        <p class="text-xs uppercase tracking-[0.24em] text-linen-300/80 font-medium">
          Casa de 1 Piso · Islas Marianas 1791, Vitacura
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium text-white tracking-tight leading-tight">
          Servicios e Instalaciones
        </h1>
        <div class="w-16 h-px bg-linen-300/40 mx-auto" />
        <p class="text-base sm:text-lg text-linen-100/90 leading-relaxed max-w-2xl mx-auto">
          Piezas individuales y compartidas en un solo nivel, atención personal las 24 horas, 5 comidas diarias, lavado de ropa y control médico semanal.
        </p>
      </div>
    </section>

    <Services />
    <Gallery />
    <Contact />
  </main>
</Layout>
