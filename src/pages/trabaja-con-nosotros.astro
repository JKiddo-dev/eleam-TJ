---
import Layout from '../layouts/Layout.astro';

const roles = [
  { value: 'Enfermería', label: 'Enfermería Universitaria' },
  { value: 'TENS', label: 'Técnico en Enfermería (TENS)' },
  { value: 'Cuidado', label: 'Asistente de Cuidado de Adulto Mayor' },
  { value: 'Cocina', label: 'Cocina y Alimentación Institucional' },
  { value: 'Aseo', label: 'Aseo, Higiene y Ropería' },
];
---

<Layout
  title="Trabaja con Nosotros | Residencia Teresita de Jesús — Vitacura"
  description="Postule a nuestro equipo profesional de cuidado del adulto mayor en Vitacura: Enfermería, TENS, Cuidado, Cocina y Aseo en Residencia Teresita de Jesús. Más de 33 años de trayectoria."
>
  <main>
    <section class="text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b border-neutral-900" style="background-color: #0e1914 !important; color: #ffffff !important;">
      <div class="max-w-4xl mx-auto text-center space-y-5">
        <p class="text-xs uppercase tracking-[0.24em] text-linen-300/80 font-medium">
          Selección y Vocación · Sede Única Vitacura
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium text-white tracking-tight leading-tight">
          Trabaja con Nosotros
        </h1>
        <div class="w-16 h-px bg-linen-300/40 mx-auto" />
        <p class="text-base sm:text-lg text-linen-100/90 leading-relaxed max-w-2xl mx-auto">
          Buscamos personas comprometidas con la dignidad, el respeto y la vocación de servicio hacia nuestros adultos mayores en Vitacura.
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-linen-50">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-5 space-y-6">
          <div>
            <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-semibold mb-2">
              Nuestro Equipo en Vitacura
            </p>
            <h2 class="font-serif text-2xl sm:text-3xl font-medium text-navy-950 tracking-tight leading-tight">
              Excelencia técnica y calidez humana
            </h2>
          </div>

          <p class="text-base text-neutral-800 leading-relaxed">
            En Residencia Teresita de Jesús valoramos la estabilidad laboral, el trabajo en equipo y el trato paciente y respetuoso. Todas nuestras labores se realizan de forma presencial en nuestra sede de calle Islas Marianas 1791, comuna de Vitacura.
          </p>

          <div class="border-t border-linen-300 pt-6 space-y-4">
            <h3 class="text-xs uppercase tracking-wider text-neutral-500 font-semibold">
              Requisitos Generales de Postulación
            </h3>
            <ul class="space-y-3 text-sm text-neutral-800">
              <li class="flex items-start gap-3">
                <span class="text-neutral-400 select-none font-bold">—</span>
                <span>Experiencia comprobable en cuidado de adultos mayores o en el área específica a la que postula.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-neutral-400 select-none font-bold">—</span>
                <span>Registro vigente en la Superintendencia de Salud (para cargos de Enfermería y TENS).</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-neutral-400 select-none font-bold">—</span>
                <span>Disponibilidad para trabajar en la comuna de Vitacura (Islas Marianas 1791).</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-neutral-400 select-none font-bold">—</span>
                <span>Referencias laborales verificables y genuina vocación de servicio.</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="bg-white border border-linen-300 rounded-2xl p-6 sm:p-10 shadow-xs">
            <div class="mb-6 pb-5 border-b border-linen-200">
              <h2 class="font-serif text-2xl font-medium text-navy-950">
                Formulario de Postulación Laboral
              </h2>
              <p class="text-sm text-neutral-600 mt-1">
                Complete sus datos para participar en nuestros procesos de selección en Vitacura.
              </p>
            </div>

            <form id="job-application-form" class="space-y-5" enctype="multipart/form-data" novalidate>
              <input type="hidden" name="formType" value="postulacion" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="job-name" class="block text-xs uppercase tracking-wider text-neutral-700 font-semibold mb-1.5">
                    Nombre completo *
                  </label>
                  <input
                    type="text"
                    id="job-name"
                    name="name"
                    required
                    placeholder="Nombre y apellidos"
                    class="w-full px-4 py-3 bg-linen-50 border border-linen-300 rounded-lg text-navy-950 text-sm focus:outline-none focus:border-forest-900 focus:ring-1 focus:ring-forest-900 transition-colors"
                  />
                </div>

                <div>
                  <label for="job-phone" class="block text-xs uppercase tracking-wider text-neutral-700 font-semibold mb-1.5">
                    Teléfono de contacto *
                  </label>
                  <input
                    type="tel"
                    id="job-phone"
                    name="phone"
                    required
                    placeholder="+56 9 1234 5678"
                    class="w-full px-4 py-3 bg-linen-50 border border-linen-300 rounded-lg text-navy-950 text-sm focus:outline-none focus:border-forest-900 focus:ring-1 focus:ring-forest-900 transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="job-email" class="block text-xs uppercase tracking-wider text-neutral-700 font-semibold mb-1.5">
                    Correo electrónico *
                  </label>
                  <input
                    type="email"
                    id="job-email"
                    name="email"
                    required
                    placeholder="nombre@correo.cl"
                    class="w-full px-4 py-3 bg-linen-50 border border-linen-300 rounded-lg text-navy-950 text-sm focus:outline-none focus:border-forest-900 focus:ring-1 focus:ring-forest-900 transition-colors"
                  />
                </div>

                <div>
                  <label for="job-role" class="block text-xs uppercase tracking-wider text-neutral-700 font-semibold mb-1.5">
                    Especialidad / Cargo *
                  </label>
                  <select
                    id="job-role"
                    name="role"
                    required
                    class="w-full px-4 py-3 bg-linen-50 border border-linen-300 rounded-lg text-navy-950 text-sm focus:outline-none focus:border-forest-900 focus:ring-1 focus:ring-forest-900 transition-colors"
                  >
                    <option value="">Seleccione un cargo...</option>
                    {roles.map((r) => <option value={r.value}>{r.label}</option>)}
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-1">
                <div>
                  <label for="job-cv-file" class="block text-xs uppercase tracking-wider text-neutral-700 font-semibold mb-1.5">
                    Adjuntar CV (PDF o Word)
                  </label>
                  <input
                    type="file"
                    id="job-cv-file"
                    name="cvFile"
                    accept=".pdf,.doc,.docx"
                    class="w-full px-3 py-2 bg-linen-50 border border-linen-300 rounded-lg text-neutral-700 text-xs file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-forest-900 file:text-white hover:file:bg-forest-800 cursor-pointer"
                  />
                  <span class="block text-[11px] text-neutral-500 mt-1">Máximo 5 MB</span>
                </div>

                <div>
                  <label for="job-cv-link" class="block text-xs uppercase tracking-wider text-neutral-700 font-semibold mb-1.5">
                    O enlace a CV / LinkedIn
                  </label>
                  <input
                    type="url"
                    id="job-cv-link"
                    name="cvLink"
                    placeholder="https://linkedin.com/in/..."
                    class="w-full px-4 py-3 bg-linen-50 border border-linen-300 rounded-lg text-navy-950 text-sm focus:outline-none focus:border-forest-900 focus:ring-1 focus:ring-forest-900 transition-colors"
                  />
                </div>
              </div>

              <div>
                <label for="job-message" class="block text-xs uppercase tracking-wider text-neutral-700 font-semibold mb-1.5">
                  Resumen de experiencia y disponibilidad
                </label>
                <textarea
                  id="job-message"
                  name="message"
                  rows="4"
                  placeholder="Indique brevemente sus años de experiencia en el área y su disponibilidad..."
                  class="w-full px-4 py-3 bg-linen-50 border border-linen-300 rounded-lg text-navy-950 text-sm focus:outline-none focus:border-forest-900 focus:ring-1 focus:ring-forest-900 transition-colors resize-none"
                ></textarea>
              </div>

              <div
                id="job-form-status"
                class="hidden p-4 rounded-lg border text-sm"
                role="status"
                aria-live="polite"
              ></div>

              <div class="pt-2">
                <button
                  type="submit"
                  id="job-submit-btn"
                  class="w-full md:w-auto px-8 py-4 bg-neutral-950 hover:bg-neutral-800 text-white font-bold rounded-xl shadow-md transition-all text-center cursor-pointer disabled:opacity-60"
                  style="background-color: #0e1914 !important; color: #ffffff !important;"
                >
                  Enviar Postulación
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const jobForm = document.getElementById('job-application-form') as HTMLFormElement | null;
  const jobSubmitBtn = document.getElementById('job-submit-btn') as HTMLButtonElement | null;
  const jobStatus = document.getElementById('job-form-status');

  jobForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!jobForm || !jobSubmitBtn || !jobStatus) return;

    jobStatus.classList.add('hidden');
    const originalText = jobSubmitBtn.textContent;
    jobSubmitBtn.disabled = true;
    jobSubmitBtn.textContent = 'Enviando postulación...';

    try {
      const formData = new FormData(jobForm);
      const response = await fetch('/api/contact', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      jobStatus.classList.remove('hidden');
      if (response.ok && result.success) {
        jobStatus.className = 'p-4 rounded-lg border border-forest-800 bg-forest-50/50 text-forest-950 text-sm';
        jobStatus.textContent = result.message;
        jobForm.reset();
      } else {
        const errorDetails = result.errors ? Object.values(result.errors).join(' ') : '';
        jobStatus.className = 'p-4 rounded-lg border border-red-800/40 bg-red-50 text-red-950 text-sm';
        jobStatus.textContent = `${result.message || 'Error al enviar la postulación.'} ${errorDetails}`.trim();
      }
    } catch {
      jobStatus.classList.remove('hidden');
      jobStatus.className = 'p-4 rounded-lg border border-red-800/40 bg-red-50 text-red-950 text-sm';
      jobStatus.textContent =
        'No fue posible conectar con el servidor. Por favor intente nuevamente en unos instantes.';
    } finally {
      jobSubmitBtn.disabled = false;
      jobSubmitBtn.textContent = originalText;
    }
  });
</script>
