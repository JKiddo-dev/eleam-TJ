---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';

const pillars = [
  {
    number: 'I',
    title: 'Comunicación y Transparencia',
    description:
      'Una relación basada plenamente en la confianza con las familias, haciéndoles saber que nuestras puertas están abiertas todos los días del año.',
  },
  {
    number: 'II',
    title: 'Atención Personal y Hogareña',
    description:
      'Un ambiente cálido con 5 comidas diarias y lavado de ropa incluido, respetando las costumbres de cada residente.',
  },
  {
    number: 'III',
    title: 'Control Médico Semanal',
    description:
      '1 visita médica personal semanal con 10 años de experiencia en el hogar, junto a enfermería las 24 horas.',
  },
];
---

<Layout
  title="Quiénes Somos | Hogar y Residencia Teresita de Jesús — Casa de Reposo en Vitacura"
  description="Historia de Hogar y Residencia Teresita de Jesús en Islas Marianas 1791, Vitacura: casa de reposo y ELEAM dedicado al cuidado de adultos mayores desde el 12 de marzo de 1988."
>
  <main>
    <section class="text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b border-neutral-900" style="background-color: #0e1914 !important; color: #ffffff !important;">
      <div class="max-w-4xl mx-auto text-center space-y-5">
        <p class="text-xs uppercase tracking-[0.24em] text-linen-300/80 font-medium">
          Nuestra Institución · Fundada un 12 de marzo
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium text-white tracking-tight leading-tight">
          Una historia creada pensando en nuestros padres
        </h1>
        <div class="w-16 h-px bg-linen-300/40 mx-auto" />
        <p class="text-base sm:text-lg text-linen-100/90 leading-relaxed max-w-2xl mx-auto">
          Residencia exclusiva para el adulto mayor en Islas Marianas 1791, Vitacura, nacida del amor familiar y consolidada en décadas de dedicación y dignidad.
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-linen-50">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-7 space-y-6">
          <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-semibold">
            Historia y Origen
          </p>
          <h2 class="font-serif text-3xl sm:text-4xl font-medium text-navy-950 tracking-tight leading-tight">
            “Un 12 de marzo se creó mi historia pensada en mis padres. Han pasado tantos años y aún me emociono.”
          </h2>
          <div class="space-y-4 text-base text-neutral-800 leading-relaxed">
            <p class="font-medium text-navy-950 text-lg leading-relaxed">
              Desde el 12 de marzo de 1988, nuestra vocación nació del deseo profundo de entregar a nuestros padres y a cada adulto mayor un lugar donde el respeto, la compañía y el afecto diario sean el centro de la vida.
            </p>
            <p>
              A lo largo de más de tres décadas hemos acompañado a cientos de residentes con múltiples y diferentes necesidades, manteniendo siempre un trato cercano y hogareño junto con un riguroso respaldo médico, clínico y humano.
            </p>
            <p>
              Hoy concentramos toda nuestra dedicación en nuestra <strong>casa de 1 piso</strong> ubicada en <strong>Islas Marianas 1791, Vitacura</strong>, ofreciendo <strong>piezas individuales y compartidas</strong>, 5 comidas diarias, lavado de ropa, visita médica semanal y atención personal las 24 horas.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-md border border-linen-300 bg-linen-100 aspect-[3/4]">
            <img
              src="/images/residencia/08-talleres-cognitivos.jpg"
              alt="Residentes compartiendo lectura y actividades en nuestra casa de un piso en Vitacura"
              width="960"
              height="1280"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-linen-100 border-y border-linen-200">
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-semibold">
          Nuestra Filosofía
        </p>
        <blockquote class="font-serif italic text-2xl sm:text-3xl text-navy-950 leading-relaxed font-normal">
          “Nos caracterizamos por una relación basada plenamente en la comunicación y la transparencia con las familias de nuestros residentes, haciéndoles saber que nuestras residencias son un segundo hogar para las familias y que nuestras puertas están abiertas todos los días del año.”
        </blockquote>
        <p class="text-xs uppercase tracking-[0.2em] text-neutral-600 font-semibold pt-2">
          Residencia Teresita de Jesús · Vitacura
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-linen-50">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-12">
          <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-semibold mb-2">
            Valores Institucionales
          </p>
          <h2 class="font-serif text-3xl font-medium text-navy-950 tracking-tight">
            Nuestros principios de acompañamiento diario
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            pillars.map((item) => (
              <article class="bg-white border border-linen-300 rounded-xl p-8 shadow-xs">
                <span class="block font-serif italic text-sm text-neutral-400 mb-2">
                  {item.number}
                </span>
                <h3 class="font-serif text-2xl font-medium text-navy-950 mb-3">
                  {item.title}
                </h3>
                <p class="text-sm sm:text-base text-neutral-700 leading-relaxed">
                  {item.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <Contact />
  </main>
</Layout>
