---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';

const pillars = [
  {
    number: 'I',
    title: 'Comunicación y Transparencia',
    description:
      'Una relación basada plenamente en la confianza con las familias, haciéndoles saber que nuestras puertas están abiertas todos los días del año.',
  },
  {
    number: 'II',
    title: 'Trato Cercano y Hogareño',
    description:
      'Un ambiente cálido donde cada residente es acogido como parte de una gran familia, respetando sus costumbres y preferencias.',
  },
  {
    number: 'III',
    title: 'Énfasis Médico y Clínico',
    description:
      'Supervisión médica periódica, enfermería 24 horas y colaboradores capacitados para responder con rigor a múltiples necesidades de salud.',
  },
];
---

<Layout
  title="Quiénes Somos | Residencia Teresita de Jesús — Más de 33 Años en Vitacura"
  description="Conozca la historia, el origen en 1988 y la filosofía de cuidado humano de Residencia Teresita de Jesús, con más de 33 años de trayectoria en Vitacura."
>
  <main>
    <section class="text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b border-neutral-900" style="background-color: #0e1914 !important; color: #ffffff !important;">
      <div class="max-w-4xl mx-auto text-center space-y-5">
        <p class="text-xs uppercase tracking-[0.24em] text-linen-300/80 font-medium">
          Nuestra Institución · Trayectoria desde 1988
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium text-white tracking-tight leading-tight">
          Más de 33 años al cuidado del adulto mayor
        </h1>
        <div class="w-16 h-px bg-linen-300/40 mx-auto" />
        <p class="text-base sm:text-lg text-linen-100/90 leading-relaxed max-w-2xl mx-auto">
          Residencia exclusiva para el adulto mayor en Vitacura, nacida de una promesa familiar y consolidada en una vocación permanente de cuidado y dignidad.
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-linen-50">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-7 space-y-6">
          <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-semibold">
            Historia y Origen
          </p>
          <h2 class="font-serif text-3xl sm:text-4xl font-medium text-navy-950 tracking-tight leading-tight">
            La promesa de una hija a su padre
          </h2>
          <div class="space-y-4 text-base text-neutral-800 leading-relaxed">
            <p class="font-medium text-navy-950 text-lg leading-relaxed">
              “Somos un grupo de residencias de adulto mayor con una trayectoria de más de 33 años, dándose inicio a nuestra primera residencia en el año 1988, comenzando por la promesa de una hija a su padre de cuidarlo por siempre.”
            </p>
            <p>
              “Durante este largo camino hemos tenido presencia en comunas como Vitacura, Ñuñoa y Providencia, cuidando a cientos de adultos mayores con múltiples y diferentes necesidades, siempre enfocándonos en el trato cercano y hogareño junto con un fuerte énfasis en nuestro equipo médico y colaboradores.”
            </p>
            <p>
              Hoy en día, concentramos toda nuestra dedicación en nuestra sede exclusiva ubicada en calle <strong>Islas Marianas 1791, Vitacura</strong>, asegurando una atención cercana, instalaciones adaptadas y un seguimiento clínico riguroso día y noche.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-sm border-2 border-dashed border-linen-300 bg-linen-100 aspect-[4/5] flex flex-col items-center justify-center p-6 text-center">
            <div class="w-14 h-14 rounded-full bg-linen-200/80 flex items-center justify-center text-neutral-400 mb-3">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <p class="text-xs uppercase tracking-widest text-neutral-500 font-semibold mb-1">
              Fotografía Institucional
            </p>
            <p class="text-xs text-neutral-400">
              En preparación · Próximamente
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-linen-100 border-y border-linen-200">
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-semibold">
          Nuestra Filosofía
        </p>
        <blockquote class="font-serif italic text-2xl sm:text-3xl text-navy-950 leading-relaxed font-normal">
          “Nos caracterizamos por una relación basada plenamente en la comunicación y la transparencia con las familias de nuestros residentes, haciéndoles saber que nuestras residencias son un segundo hogar para las familias y que nuestras puertas están abiertas todos los días del año.”
        </blockquote>
        <p class="text-xs uppercase tracking-[0.2em] text-neutral-600 font-semibold pt-2">
          Residencia Teresita de Jesús · Vitacura
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-linen-50">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-12">
          <p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-semibold mb-2">
            Valores Institucionales
          </p>
          <h2 class="font-serif text-3xl font-medium text-navy-950 tracking-tight">
            Nuestros principios de acompañamiento diario
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            pillars.map((item) => (
              <article class="bg-white border border-linen-300 rounded-xl p-8 shadow-xs">
                <span class="block font-serif italic text-sm text-neutral-400 mb-2">
                  {item.number}
                </span>
                <h3 class="font-serif text-2xl font-medium text-navy-950 mb-3">
                  {item.title}
                </h3>
                <p class="text-sm sm:text-base text-neutral-700 leading-relaxed">
                  {item.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <Contact />
  </main>
</Layout>
