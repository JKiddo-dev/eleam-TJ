---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  extraSchema?: Record<string, unknown>[];
}

const SITE_URL = 'https://eleamteresitadejesus.cl';

const {
  title = 'Hogar Teresita de Jesús | Residencia y Casa de Reposo en Vitacura (ELEAM)',
  description = 'Hogar y Residencia Teresita de Jesús: casa de reposo y ELEAM para el cuidado de adultos mayores en Islas Marianas 1791, Vitacura. Casa de 1 piso, piezas individuales y compartidas, enfermería 24/7 y médico semanal.',
  noindex = false,
  extraSchema = [],
} = Astro.props;

const cleanPath =
  Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalURL = new URL(cleanPath, Astro.site ?? SITE_URL).toString();
const ogImageURL = `${SITE_URL}/images/residencia/01-jardin-convivencia.jpg`;

const routeNames: Record<string, string> = {
  '/servicios-e-instalaciones': 'Servicios e Instalaciones',
  '/quienes-somos': 'Quiénes Somos',
  '/testimonios': 'Testimonios',
};

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Inicio',
    item: `${SITE_URL}/`,
  },
  ...(cleanPath !== '/' && routeNames[cleanPath]
    ? [
        {
          '@type': 'ListItem',
          position: 2,
          name: routeNames[cleanPath],
          item: canonicalURL,
        },
      ]
    : []),
];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'LodgingBusiness', 'MedicalBusiness'],
      '@id': `${SITE_URL}/#organization`,
      name: 'Residencia Teresita de Jesús',
      alternateName: [
        'Hogar Teresita de Jesús',
        'ELEAM Teresita de Jesús',
        'Hogar de Reposo Teresita de Jesús',
        'Casa de Reposo Teresita de Jesús Vitacura',
      ],
      description:
        'Residencia de adulto mayor, hogar de reposo y ELEAM exclusivo en Vitacura (Islas Marianas 1791). Casa de 1 piso con piezas individuales y compartidas, atención personal, enfermería TENS 24 horas, 5 comidas diarias y visita médica semanal.',
      url: SITE_URL,
      foundingDate: '1988-03-12',
      telephone: '+56 9 7965 5573',
      priceRange: '$$$',
      image: [
        `${SITE_URL}/images/residencia/01-jardin-convivencia.jpg`,
        `${SITE_URL}/images/residencia/02-habitacion-luminosa.jpg`,
        `${SITE_URL}/images/residencia/03-terraza-jardin.jpg`,
        `${SITE_URL}/images/residencia/10-salon-principal.jpg`,
      ],
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Islas Marianas 1791',
        addressLocality: 'Vitacura',
        addressRegion: 'Región Metropolitana',
        postalCode: '7630000',
        addressCountry: 'CL',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: -33.3875971,
        longitude: -70.570791,
      },
      hasMap: 'https://maps.google.com/?q=Islas+Marianas+1791,+Vitacura,+Chile',
      areaServed: [
        {
          '@type': 'AdministrativeArea',
          name: 'Vitacura',
        },
        {
          '@type': 'City',
          name: 'Santiago',
        },
      ],
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: '+56-9-7965-5573',
          contactType: 'admissions',
          areaServed: 'CL',
          availableLanguage: ['Spanish'],
        },
        {
          '@type': 'ContactPoint',
          telephone: '+56-2-2219-0398',
          contactType: 'customer service',
          areaServed: 'CL',
          availableLanguage: ['Spanish'],
        },
      ],
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: [
            'Monday',
            'Tuesday',
            'Wednesday',
            'Thursday',
            'Friday',
            'Saturday',
            'Sunday',
          ],
          opens: '00:00',
          closes: '23:59',
        },
      ],
      amenityFeature: [
        { '@type': 'LocationFeatureSpecification', name: 'Casa de 1 piso sin escaleras', value: true },
        { '@type': 'LocationFeatureSpecification', name: 'Piezas individuales y compartidas', value: true },
        { '@type': 'LocationFeatureSpecification', name: 'Atención personal y TENS 24 horas', value: true },
        { '@type': 'LocationFeatureSpecification', name: '1 visita médica personal semanal', value: true },
        { '@type': 'LocationFeatureSpecification', name: '5 comidas diarias caseras', value: true },
        { '@type': 'LocationFeatureSpecification', name: 'Lavado de ropa y aseo diario', value: true },
        { '@type': 'LocationFeatureSpecification', name: 'Jardines y terrazas soleadas', value: true },
      ],
      knowsAbout: [
        'Hogar de reposo en Vitacura',
        'Casa de reposo en Vitacura',
        'Residencia de adulto mayor en Vitacura',
        'Cuidado de adultos mayores',
        'ELEAM en Vitacura',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: 'Residencia y Hogar Teresita de Jesús — ELEAM Vitacura',
      alternateName: 'Hogar Teresita de Jesús',
      inLanguage: 'es-CL',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
    ...extraSchema,
  ],
};
---

<!doctype html>
<html lang="es-CL" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Hogar Teresita de Jesús, Residencia Teresita de Jesús, ELEAM Teresita de Jesús, hogares de reposo en Vitacura, hogar de reposo Vitacura, casa de reposo en Vitacura, residencia adulto mayor Vitacura, cuidado de adultos mayores Vitacura, ELEAM Vitacura"
    />
    <meta name="author" content="Residencia y Hogar Teresita de Jesús — Vitacura" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es-CL" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <meta name="geo.region" content="CL-RM" />
    <meta name="geo.placename" content="Vitacura, Santiago, Chile" />
    <meta name="geo.position" content="-33.3875971;-70.5707910" />
    <meta name="ICBM" content="-33.3875971, -70.5707910" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Hogar y Residencia Teresita de Jesús · ELEAM Vitacura" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1600" />
    <meta property="og:image:alt" content="Jardines y residentes de Hogar y Residencia Teresita de Jesús en Vitacura" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body class="bg-[#F9F8F6] text-neutral-900 font-sans antialiased flex flex-col min-h-screen" style="background-color: #F9F8F6; color: #171717;">
    <Navbar />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
